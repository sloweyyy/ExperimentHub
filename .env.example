# ExperimentHub Environment Configuration
# Copy this file to .env and adjust values for your environment.

# ── Database ──────────────────────────────────────────────
# Local development (SQLite, zero setup):
DATABASE_URL=sqlite:///./experiment_db.sqlite

# Docker Compose (PostgreSQL):
# DATABASE_URL=postgresql://postgres:postgres@db:5432/experimenthub

# ── PostgreSQL (Docker Compose only) ─────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=experimenthub

# ── Frontend ─────────────────────────────────────────────
# API URL the frontend uses to reach the backend.
# Local development:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Docker Compose (container networking):
# NEXT_PUBLIC_API_URL=http://backend:8000

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed origins for the backend.
# Local development:
CORS_ORIGINS=http://localhost:3000

# Docker Compose:
# CORS_ORIGINS=http://localhost:3000,http://frontend:3000
